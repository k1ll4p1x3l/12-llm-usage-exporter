{
  "$id": "urn:agent-core:repository-agent-overlay:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "minLength": 1,
      "type": "string"
    },
    "classification": {
      "enum": [
        "public-safe",
        "repository-internal"
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "instruction_file": {
      "not": {
        "enum": [
          ".",
          ".."
        ]
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "max_bytes": {
      "maximum": 12288,
      "minimum": 1,
      "type": "integer"
    },
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "$schema",
    "schema_version",
    "enabled",
    "instruction_file",
    "max_bytes",
    "classification"
  ],
  "title": "Repository Agent Overlay Manifest",
  "type": "object"
}
